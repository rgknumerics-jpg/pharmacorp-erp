# Copiez en .env.test. Pointe vers l'environnement isole de docker-compose.test.yml.

NODE_ENV=test
PORT=3001

# "erp_app" = role non-superuser/non-BYPASSRLS, indispensable pour que RLS s'applique (voir .env)
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5433/erp_test?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

JWT_ACCESS_SECRET=test-access-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-refresh-secret-min-32-characters-long
JWT_REFRESH_TTL=7d

SEED_TENANT_NAME=Pharmacie Pilote
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
