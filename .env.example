# Copiez ce fichier en .env (developpement) et en .env.test (tests) puis adaptez les valeurs.

NODE_ENV=development
PORT=3000

# PostgreSQL (port hote 5442 : voir docker-compose.yml, une autre infra Docker occupe 5432 sur cette machine)
# "erp_app" = role applicatif non-superuser/non-BYPASSRLS (obligatoire pour que la Row-Level
# Security multi-tenant s'applique -- un superuser la contourne toujours). Pour les commandes
# prisma migrate/db:seed, utilisez temporairement le role proprietaire "erp" a la place.
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5442/erp_dev?schema=public

# Redis (port hote 6389, meme raison)
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=7d

# Bootstrap du premier tenant/administrateur (utilise par le seed)
SEED_TENANT_NAME=Pharmacie Pilote
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Frontend
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# Assistant IA (Pilotage) : facultatif. Module desactive par defaut (Panneau d'administration -> Fonctions) ;
# sans cette cle il refuse proprement, rien ne casse. A renseigner seulement le jour du deploiement reel
# (console.anthropic.com -> API Keys) -- jamais commitee.
ANTHROPIC_API_KEY=
